[Unit]
Description=DTLab Control Center v2 staging
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=web75
Group=dtlab-dashboard
WorkingDirectory=/var/www/clients/client1/web75/private/modbus-dashboard-staging-current
Environment=PYTHONPATH=/var/www/clients/client1/web75/private/modbus-dashboard-staging-current/src
Environment=DTLAB_SNAPSHOT_STORE=/var/www/clients/client1/web75/private/modbus-dashboard-data-staging
Environment=DTLAB_TICKET_STORE=/var/www/clients/client1/web75/private/modbus-dashboard-ticket-data-staging/tickets.sqlite3
Environment=DTLAB_HOST_OT_EVENT_STORE=/var/www/clients/client1/web75/private/modbus-dashboard-host-ot-data-staging
Environment=DTLAB_UI_REFRESH_SECONDS=15
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ExecStart=/var/www/clients/client1/web75/private/modbus-dashboard-staging-venv-current/bin/python -m streamlit run app.py --server.address=127.0.0.1 --server.port=8518 --server.headless=true
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/www/clients/client1/web75/private/modbus-dashboard-releases
ReadOnlyPaths=/var/www/clients/client1/web75/private/modbus-dashboard-venvs
ReadOnlyPaths=/var/www/clients/client1/web75/private/modbus-dashboard-data-staging
ReadOnlyPaths=-/var/www/clients/client1/web75/private/modbus-dashboard-host-ot-data-staging
ReadWritePaths=/var/www/clients/client1/web75/private/modbus-dashboard-ticket-data-staging
InaccessiblePaths=/var/www/clients/client1/web75/private/modbus-dashboard

[Install]
WantedBy=multi-user.target
