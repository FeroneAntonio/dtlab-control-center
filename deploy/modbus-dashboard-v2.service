[Unit]
Description=DTLab Control Center v2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=web75
Group=dtlab-dashboard
WorkingDirectory=/var/www/clients/client1/web75/private/modbus-dashboard-current
Environment=PYTHONPATH=/var/www/clients/client1/web75/private/modbus-dashboard-current/src
Environment=DTLAB_SNAPSHOT_STORE=/var/www/clients/client1/web75/private/modbus-dashboard-data
Environment=DTLAB_TICKET_STORE=/var/www/clients/client1/web75/private/modbus-dashboard-ticket-data/tickets.sqlite3
Environment=DTLAB_HOST_OT_EVENT_STORE=/var/www/clients/client1/web75/private/modbus-dashboard-host-ot-data
Environment=DTLAB_UI_REFRESH_SECONDS=15
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ExecStart=/var/www/clients/client1/web75/private/modbus-dashboard-venv-current/bin/python -m streamlit run app.py --server.address=127.0.0.1 --server.port=8517 --server.headless=true
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/www/clients/client1/web75/private/modbus-dashboard-releases
ReadOnlyPaths=/var/www/clients/client1/web75/private/modbus-dashboard-venvs
ReadOnlyPaths=/var/www/clients/client1/web75/private/modbus-dashboard-data
ReadOnlyPaths=-/var/www/clients/client1/web75/private/modbus-dashboard-host-ot-data
ReadWritePaths=/var/www/clients/client1/web75/private/modbus-dashboard-ticket-data
InaccessiblePaths=/var/www/clients/client1/web75/private/modbus-dashboard

[Install]
WantedBy=multi-user.target
